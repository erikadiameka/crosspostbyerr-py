# ====== CREDENTIALS & API KEYS ======

# YouTube API (Google Cloud Console)
YOUTUBE_CLIENT_ID=your_google_client_id_here
YOUTUBE_CLIENT_SECRET=your_google_client_secret_here

# Meta API (Instagram & Facebook Graph API)
META_ACCESS_TOKEN=your_meta_long_lived_access_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_id_here
FACEBOOK_PAGE_ID=your_facebook_page_id_here

# TikTok Automation (Jika pakai login cookies/session)
TIKTOK_SESSION_ID=your_tiktok_session_id_here

# ====== APP SETTINGS ======
APP_ENV=devel